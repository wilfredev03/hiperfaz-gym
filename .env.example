APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Caracas

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Correo al que se envía el reporte al cerrar una caja (ver CierreCajaController).
CIERRE_CAJA_EMAIL_NOTIFICACION=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Colores de marca de esta instalación (ver config/branding.php). Vacío =
# paleta neutra por defecto (blanco/negro). Acepta hex, hsl() u oklch() —
# entre comillas siempre (ej. BRAND_PRIMARY="#a8460f"): sin comillas, el "#"
# de un hex se interpreta como inicio de comentario y el valor queda vacío.
BRAND_BACKGROUND=
BRAND_FOREGROUND=
BRAND_PRIMARY=
BRAND_PRIMARY_FOREGROUND=
BRAND_SECONDARY=
BRAND_SECONDARY_FOREGROUND=
BRAND_SIDEBAR_BACKGROUND=
BRAND_SIDEBAR_FOREGROUND=
# Rutas públicas del logo/ícono de esta instalación, una por tema. Vacío =
# se muestra un genérico (ícono + nombre de la app) en vez del logo de otro.
BRAND_LOGO_URL_LIGHT=
BRAND_LOGO_URL_DARK=
BRAND_ICON_URL_LIGHT=
BRAND_ICON_URL_DARK=
BRAND_FAVICON_URL_LIGHT=
BRAND_FAVICON_URL_DARK=
# --- HTTPS de desarrollo (para probar "Compartir" desde tablet/celular) -------
# 1) scripts/generar-certificado-dev.sh <IP-de-esta-PC>
# 2) php artisan serve --host=0.0.0.0 --port=8000 ; npm run dev ; npm run dev:https
# 3) APP_URL=https://<IP>:8443 , VITE_DEV_HOST=<IP> , VITE_HTTPS=true , SESSION_SECURE_COOKIE=true
# 4) instalar storage/ssl/dev-ca.crt en la tablet (Ajustes > Seguridad > Instalar certificado CA)
