# Debe ser el mismo valor que WHATSAPP_TOKEN en el .env de Laravel.
# Genera uno largo: php -r "echo bin2hex(random_bytes(32));"
WHATSAPP_TOKEN=

# El bot siempre escucha en 127.0.0.1; solo se cambia el puerto
# (y entonces también WHATSAPP_URL en el .env de Laravel).
PORT=3100

# Donde se guarda la sesión de WhatsApp (es como una contraseña: no se sube a git).
AUTH_DIR=./auth

# Historial de la sesión (QR, conexión, caídas). Se guarda aparte de AUTH_DIR
# para que sobreviva a cerrar la sesión; Laravel lo consulta por /eventos.
EVENTOS_FILE=./eventos.jsonl

# Minutos de vigencia del QR para vincular (en segundos). Pasado ese tiempo el bot
# deja de generar códigos y el panel ofrece un botón para pedir uno nuevo.
QR_TIMEOUT_SEG=120
